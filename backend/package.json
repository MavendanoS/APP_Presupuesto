{
  "name": "app-presupuesto-backend",
  "version": "4.0.0",
  "description": "API Backend para seguimiento de pagos e ingresos mensuales - Cloudflare Worker",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "test": "node --test \"tests/unit/*.test.js\"",
    "db:create": "wrangler d1 create gastos-db",
    "db:schema:local": "wrangler d1 execute gastos-db --local --file=../database/schema.sql",
    "db:backup": "wrangler d1 export gastos-db --remote --output=backup.sql"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "api",
    "pagos"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "itty-router": "^4.0.0",
    "resend": "^6.5.2"
  },
  "devDependencies": {
    "wrangler": "^4.47.0"
  }
}
